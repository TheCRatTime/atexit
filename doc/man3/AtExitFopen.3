.TH "AtExitFopen" "3" "2026\-09\-29" "TheCRatTime" "AtExit reference"
.SH NAME
\fBAtExitFopen\fR \- wrapper for \fBSetAtExit\fR(3) and \fBfopen\fR(3)
.PP
.SH SYNOPSIS
\fB#include\fR <\fBatexit.\&h\fR>
.br
\fB#include\fR <\fBstdio.\&h\fR>
.PP
\fBFILE* AtExitFopen(AtExitHeader* \fIhead\fB, const char* \fIfilename\fB,
.br
                  const char* \fImodes\fB);\fR
.PP
.SH DESCRIPTION
This is just wrapper.
.PP
\fIhead\fR
.RS 4
\fBAtExitHeader\fR struct.\& Need for set auto\-free.\&
.RE
.PP
\fIfilename\fR
.RS 4
File name to open.\&
.RE
.PP
\fImodes\fR
.RS 4
Modes for \fBfopen\fR(3).\&
.RE
.PP
.SH RETURN VALUE
The same as \fBfopen\fR(3).\&
.PP
.SH EXAMPLES
.nf
#include <atexit.h>

#include <stdlib.h>

int main(void) {
  /* init AtExitHeader with name atexit_h... */
  FILE* file = (FILE*)AtExitFopen(atexit_h, "testfile.c", "re");
  if (file == NULL) {
	/* Free and do AtExit atexit_h */
	DoAtExit(atexit_h);
	free(atexit_h)
	/* ... */
	return 1;
  }

  /* ... */
  return 0;
}
.fi
.PP
.SH AUTHORS
Project and man-page: TheCRatTime
.PP
.SH SEE ALSO
